[Unit]
Description=PictoRust secure MLS relay (local upstream to HTTPS proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pictorust
Group=pictorust
WorkingDirectory=/opt/pictorust
EnvironmentFile=/etc/pictorust/relay.env
ExecStart=/opt/pictorust/pictochat-relay
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/pictorust
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
