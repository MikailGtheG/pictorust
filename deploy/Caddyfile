# TLS terminates at Caddy; the Rust MLS relay never binds publicly.
# Set PICTORUST_DOMAIN=chat.example.org in Caddy's systemd environment.
# No untrusted X-Forwarded-Host/Proto headers are consumed by the relay.
{$PICTORUST_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 48KB
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
    reverse_proxy 127.0.0.1:8787 {
        header_up Host {host}
        header_up -X-Forwarded-Host
        header_up -X-Forwarded-Proto
        header_up -X-Forwarded-For
    }
    log {
        output file /var/log/caddy/pictorust-access.log {
            roll_size 5MiB
            roll_keep 4
            roll_keep_for 72h
        }
        format filter {
            request>uri replace "invite=" "[redacted]"
            request>headers>Authorization delete
            request>headers>Cookie delete
            request>headers>Sec-WebSocket-Protocol delete
        }
    }
}
